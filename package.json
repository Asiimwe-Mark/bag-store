{
  "name": "lorah-exquisite-trends",
  "version": "1.0.0",
  "description": "Premium Luxury Handbags for Elegant Women in Uganda - LORAH Exquisite Trends",
  "author": "LORAH Team",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .js,.jsx",
    "format": "prettier --write \"src/**/*.{js,jsx,css,scss,json}\"",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-unused-vars": "warn",
      "no-console": "off"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "handbags",
    "luxury-bags",
    "fashion",
    "uganda",
    "ecommerce",
    "react",
    "tailwindcss"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/lorah-exquisite-trends.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/lorah-exquisite-trends/issues"
  },
  "homepage": "https://lorah-exquisite-trends.vercel.app",
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "gh-pages": "^6.1.0",
    "postcss": "^8.4.31",
    "prettier": "^3.1.0",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^3.3.5"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}